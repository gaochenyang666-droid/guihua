# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///guijing.db

# BSC Mainnet（真实 BNB）
BSC_RPC_URL=https://bsc-dataseed.binance.org/
RECEIVE_ADDRESS=0xYourReceiveAddressHere
# 发帖费（单位：BNB，勿填 Wei）。当前全站 0.001 BNB
POST_FEE=0.001

# 打赏自动打款：平台热钱包私钥（与 RECEIVE_ADDRESS 对应的私钥）。不配置则只记账不自动转款给作者
# PLATFORM_PRIVATE_KEY=0x...

# 脚本发帖（scripts/post_with_key.py）：用于测试发帖的 BSC 钱包私钥，勿与平台热钱包混用
# WALLET_PRIVATE_KEY=0x...

# ImgBB Configuration
IMGBB_API_KEY=your-imgbb-api-key

# Arweave Configuration
# Option 1: Path to key file
AR_KEY_FILE=ar_key.json
# Option 2: JSON content of key file
AR_KEY_DATA={"kty": "RSA", ...}

# Pinata Configuration (Optional)
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-key
