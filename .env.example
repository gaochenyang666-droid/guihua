# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-here
# 生产环境禁止每次重启插入种子数据：不设或设为 false。需造数时临时设为 true 部署一次后改回。
# ALLOW_INIT_DB=false
# 数据库：生产环境请用 PostgreSQL 等持久化库；SQLite 时建议用绝对路径，否则重启后可能丢数据（云平台请务必用托管数据库）
# DATABASE_URL=sqlite:///guijing.db
# 示例（绝对路径）: DATABASE_URL=sqlite:////var/data/guihua/guijing.db
#
# --- Render 部署（必读）---
# Render 磁盘是临时的，重启/部署会清空，用 SQLite 帖子会丢。必须加 PostgreSQL：
# 1. 在 Render Dashboard → 你的 Web Service → Environment 旁点 “Add Environment Group” 或 “New +”
# 2. 左侧 “Create” → PostgreSQL，建一个库（如 guihua-db）
# 3. 建好后进入该数据库，在 “Info” 里复制 “Internal Database URL”（同 Service 内网用）或 “External Database URL”
# 4. 在 Web Service 的 Environment 里添加变量：DATABASE_URL = 粘贴的地址（形如 postgresql://user:pass@host/dbname）
# 5. 重新 Deploy。首次启动后表会自动创建（db.create_all），帖子会持久保存。
# 若首页仍无帖子：在 Render 的 Shell 中执行 python3 scripts/seed_posts.py 恢复种子帖（华先生访问记）。

# BSC Mainnet（发帖费与打赏均为 USDT BEP-20）
BSC_RPC_URL=https://bsc-dataseed.binance.org/
RECEIVE_ADDRESS=0xYourReceiveAddressHere
# 发帖费：1 人民币等值 USDT（接口取 USD/CNY 换算，取价失败时用 POST_FEE_USDT 兜底）
POST_FEE_CNY=1
POST_FEE_USDT=0.14
# BSC 主网 USDT 合约（不填则用默认 Binance-Peg BSC-USD）
# USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# NFT 铸造（发帖上 Arweave 后自动铸造）：合约地址 + 铸造用私钥（需有 mint(to, tokenURI) 接口）
# NFT_CONTRACT_ADDRESS=0x...
# ADMIN_PRIVATE_KEY=0x...

# 打赏自动打款：平台热钱包私钥（必为 RECEIVE_ADDRESS 对应的私钥）
# 填写方式：与 RECEIVE_ADDRESS 同一钱包的私钥，64 位十六进制，可带 0x 前缀。例如：
#   PLATFORM_PRIVATE_KEY=0x你的64位十六进制私钥
# 该钱包用于：收到打赏 USDT 后，自动把 93% USDT 转给作者（需钱包里有余量 USDT + 少量 BNB 付 gas）。不配置则只记账不自动转款。
# PLATFORM_PRIVATE_KEY=0x...

# 脚本发帖（scripts/post_with_key.py）：用于测试发帖的 BSC 钱包私钥，勿与平台热钱包混用
# WALLET_PRIVATE_KEY=0x...

# ImgBB Configuration
IMGBB_API_KEY=your-imgbb-api-key

# Arweave Configuration
# Option 1: Path to key file
AR_KEY_FILE=ar_key.json
# Option 2: JSON content of key file
AR_KEY_DATA={"kty": "RSA", ...}

# Pinata Configuration (Optional)
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-key

# WalletConnect（扫码登录：币安/Trust 等钱包扫码）
# 在 https://cloud.walletconnect.com 注册项目获取 Project ID，不配置则隐藏「扫码登录」入口
# WALLETCONNECT_PROJECT_ID=

# 上线前：请将本文件及 requirements.txt 与关键密钥在安全处做离线备份，勿将 .env 提交到 Git。
